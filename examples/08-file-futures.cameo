-- Files are deterministic fixtures. Future continuations run on the owning VM.
let root = arg[1] or "examples/fixtures"
fn normalize(text: string) -> string {
    return text.match("^%s*(.-)%s*$")
}

fn label(text: string) -> Future<string> {
    return Future.completedFuture("release: " .. text.upper())
}

let release = aio.readFile(root .. "/release.txt")
    .thenApply(normalize)
    .thenCompose(label)
    .get()
let contents = aio.readFile(root .. "/digest.txt").get()
print(release)
print($"sha256: {crypto.sha256(contents)}")

-- A callback that invokes get is explicitly bound; extracting a method is not binding.
let completed = Future.completedFuture(7)
let fetch = () => completed.get()
print($"bound callback: {fetch()}")
