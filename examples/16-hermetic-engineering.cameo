// Flagship "Better Starlark" showcase: strictly hermetic (--hermetic) engineering
// & financial BOM evaluator combining static records (required + optional fields),
// interfaces, exhaustive enum match, List/Dict, comprehensions, deep freeze,
// deterministic parallel.map, SharpUnits (ISO 80000 affine points + SIMD series),
// and SharpSafeNumerics (IEEE Decimal64, Q32.32 Fixed64, SIMD checked integers).

enum RailClass {
    "Core",
    "Io",
    "Aux"
}

interface Priced {
    fn lineTotal() -> safenum.Decimal64
}

record RailSpec implements Priced {
    name: string
    rail: RailClass
    voltage: SharpUnits.Quantity
    current: SharpUnits.Quantity
    unitCost: safenum.Decimal64
    count: integer
    note?: string

    fn power() -> SharpUnits.Quantity {
        return (self.voltage * self.current).in_unit("W")
    }

    fn lineTotal() -> safenum.Decimal64 {
        return self.unitCost * safenum.dec64(self.count)
    }
}

fn priorityLabel(cls: RailClass) -> string {
    return match cls {
        "Core" => "P0-critical",
        "Io" => "P1-interface",
        "Aux" => "P2-auxiliary"
    }
}

let rails: List<RailSpec> = [
    RailSpec {
        name = "VDD_CORE",
        rail = "Core",
        voltage = units.qty(1.25, "V"),
        current = units.qty(16.0, "A"),
        unitCost = safenum.dec64("14.95"),
        count = 4,
        note = "main compute rail"
    },
    RailSpec {
        name = "VDD_IO",
        rail = "Io",
        voltage = units.qty(3.3, "V"),
        current = units.qty(4.0, "A"),
        unitCost = safenum.dec64("6.50"),
        count = 6
    },
    RailSpec {
        name = "FAN_AUX",
        rail = "Aux",
        voltage = units.qty(12.0, "V"),
        current = units.qty(0.75, "A"),
        unitCost = safenum.dec64("4.25"),
        count = 2,
        note = "thermal blower"
    }
]

// Deep-freeze the BOM specification before sharing across deterministic workers.
freeze(rails)
print($"bom frozen: {isFrozen(rails)}")

// Insertion-ordered Dict + direct for-in iteration.
let byRail: Dict<string, SharpUnits.Quantity> = Dict.new()
for r in rails {
    byRail.set(r.name, r.power())
}
for name, pwr in byRail {
    print($"rail {name}: {pwr}")
}

// List comprehension + exhaustive enum match.
let criticalNames = [$"{r.name}({priorityLabel(r.rail)})" for r in rails if r.rail != "Aux"]
print("critical rails: " .. table.concat(criticalNames.toTable(), ", "))

// Exact IEEE 754 Decimal64 BOM pricing via Priced interface (zero binary-float drift).
var totalCost: safenum.Decimal64 = safenum.dec64("0.00")
for r in rails {
    let priced: Priced = r
    totalCost = totalCost + priced.lineTotal()
}
let taxRate = safenum.dec64("1.0825")
let grandTotal = totalCost * taxRate
print($"bom subtotal: ${totalCost}, with 8.25% tax: ${grandTotal}")

// Deterministic parallel.map across workers transferring Quantity values.
let hourlyEnergy: List<SharpUnits.Quantity> = parallel.map(
    [r.power() for r in rails],
    (pwr: SharpUnits.Quantity) -> SharpUnits.Quantity => (pwr * units.qty(24, "h")).in_unit("kJ")
)
let energySummary = [e.format("F2") for e in hourlyEnergy]
print("24h energy (parallel.map): " .. table.concat(energySummary.toTable(), ", "))

// ISO 80000 affine temperature & pressure safety + SIMD QuantitySeries telemetry.
let ambient = units.point(25, "°C")
let junction = units.point(85, "°C")
let rise = junction - ambient
let manifold = units.point(2.5, "bar", "gauge")
let samples = units.series([1.24, 1.25, 1.26, 1.25], "V")
print($"thermal rise: {rise} (junction {string.format('%.1f', junction.to_fahrenheit().value)} °F)")
print($"manifold absolute: {manifold.relative_to('vacuum').value} bar, core rail rms: {samples.rms().format('F4')}")

// SafeNumerics SIMD checked integer batch & exact Q32.32 fixed-point derating factor.
let batch = safenum.intAddBatch([4, 6, 2], [1, 2, 1])
let derate, derateErr = safenum.fixedFromRatio(3, 4)
let _, inexactErr = safenum.fixedFromRatio(4, 5, "exact")
print($"inventory + spares: {json.encode(batch.values)}, errors={json.encode(batch.errors)}, derate={derate} ({derateErr}), 4/5 exact={inexactErr}")
